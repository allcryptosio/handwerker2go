# Kopiere diese Datei nach .env.local und trage echte Werte ein. Niemals echte Schlüssel committen.

# Öffentliche Basis-URL (für Canonical, Sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://handwerker2go.com
# 1 = Seite für Suchmaschinen sperren (Vorschau/Staging)
NEXT_PUBLIC_NOINDEX=1

# Supabase (ab Phase 2)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Connect (Accounts v2, Managed Risk), Billing und Tax. Nur Test-Schlüssel (sk_test_…). Live-Schlüssel werden abgelehnt, solange STRIPE_ALLOW_LIVE nicht 1 ist.
STRIPE_ALLOW_LIVE=0
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# Werte für Preise, Provisionsprodukt und Portal liefert: node --env-file=.env.local scripts/stripe-setup.mjs
STRIPE_PRODUCT_COMMISSION=
STRIPE_PORTAL_CONFIG=
STRIPE_PAYMENT_METHOD_CONFIG=
# Webhook-Endpunkt: https://handwerker2go.com/api/stripe/webhook 
#   Ereignisse vom eigenen Konto: customer.subscription.*, checkout.session.completed, invoice.payment_failed
#   Ereignisse von verbundenen Konten: account.updated, checkout.session.completed, charge.refunded, charge.dispute.*

# E-Mail über Resend (ab Phase 5)
RESEND_API_KEY=
EMAIL_FROM="handwerker2go <hallo@handwerker2go.com>"

# Karten und Geocoding über Mapbox (ab Phase 3)
NEXT_PUBLIC_MAPBOX_TOKEN=
MAPBOX_SECRET_TOKEN=

# Datenbank. Eigener Server: zwei Rollen (App an RLS gebunden, Owner nur für Migrationen).
# Supabase: Verbindungs-URI aus dem Dashboard (Connect > Session pooler) für beide eintragen.
DATABASE_URL=postgres://h2g_app:PASSWORT@127.0.0.1:5432/handwerker2go
DATABASE_URL_MIGRATIONS=postgres://h2g_owner:PASSWORT@127.0.0.1:5432/handwerker2go

# Anmeldung (Better Auth), Secret mit `openssl rand -base64 32` erzeugen
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=https://handwerker2go.com

# E-Mail: outbox (nur speichern), smtp (z. B. Google Workspace mit App-Passwort) oder resend
MAIL_DRIVER=outbox
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=

# Dateispeicher: local (STORAGE_DIR). Später s3 für Supabase Storage oder anderen S3-Speicher.
STORAGE_DRIVER=local
STORAGE_DIR=/var/lib/handwerker2go/uploads
