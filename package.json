{
  "name": "handwerker2go",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3012",
    "build": "next build",
    "start": "next start -p 3012 -H 127.0.0.1",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "db:migrate": "node --env-file=.env.local scripts/migrate.mjs",
    "admin:create": "node --env-file=.env.local scripts/create-admin.mjs",
    "stripe:setup": "node --env-file=.env.local scripts/stripe-setup.mjs",
    "stripe:commission": "node --env-file=.env.local scripts/commission-invoices.mjs",
    "test": "node --import tsx --no-warnings --test tests/*.test.ts",
    "geo:import": "node --env-file=.env.local scripts/import-postal-codes.mjs"
  },
  "dependencies": {
    "better-auth": "^1.7.25",
    "next": "16.4.6",
    "nodemailer": "^10.6.0",
    "pg": "^8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "stripe": "^23.1.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@10.33.3"
}
